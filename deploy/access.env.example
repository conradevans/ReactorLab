# Cloudflare Access values for ReactorLab's administrator application.
# Copy to /etc/reactorlab/access.env during an authorized deployment and
# restrict it to root. Do not commit real values.
REACTORLAB_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
REACTORLAB_ACCESS_AUDIENCE=
REACTORLAB_ACCESS_ADMIN_EMAIL=
