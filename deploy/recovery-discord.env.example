# Optional recovery Discord notification settings.
# Install as /etc/reactorlab/recovery-discord.env with root ownership and mode 0600.
# The webhook URL itself belongs only in REACTORLAB_DISCORD_WEBHOOK_FILE.
REACTORLAB_RECOVERY_DISCORD_ENABLED=false
REACTORLAB_DISCORD_WEBHOOK_FILE=/etc/reactorlab/discord-webhook
REACTORLAB_RECOVERY_NOTIFICATION_TIMEZONE=America/New_York
# REACTORLAB_DISCORD_USERNAME=ReactorLab
